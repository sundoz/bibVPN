# {{ ansible_managed }}
[Unit]
Description=Xray proxy (bibVPN)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=xray
Group=xray
Environment=XRAY_LOCATION_ASSET={{ xray_base_dir }}/current
ExecStart={{ xray_base_dir }}/current/xray run -config {{ xray_config_dir }}/config.json
Restart=always
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
